---
import { site } from '../data/site';
---
<section class="section section--tint" id="calculator">
  <div class="wrap">
    <p class="eyebrow">Estimate</p>
    <h2>What slow response is costing you.</h2>
    <p class="lede" style="margin-bottom:2.6rem;">
      Three inputs. It uses the drop-off rates we see between response-time bands,
      so treat it as an order of magnitude rather than a forecast.
    </p>

    <div class="calc">
      <div class="calc__inputs">
        <div class="calc__field">
          <label for="calc-leads">Monthly inbound lead volume</label>
          <select id="calc-leads">
            <option value="30">Fewer than 50 a month</option>
            <option value="125" selected>50 to 200 a month</option>
            <option value="350">200 to 500 a month</option>
            <option value="700">More than 500 a month</option>
          </select>
        </div>
        <div class="calc__field">
          <label for="calc-time">Average time to first response</label>
          <select id="calc-time">
            <option value="0.05">Under an hour</option>
            <option value="0.15">One to four hours</option>
            <option value="0.25" selected>Four to twenty-four hours</option>
            <option value="0.40">More than a day</option>
          </select>
        </div>
        <div class="calc__field">
          <label for="calc-value">Average value of a closed deal (USD)</label>
          <input id="calc-value" type="number" inputmode="numeric" min="1000" step="1000" value="52000" />
        </div>
      </div>

      <div class="calc__out" aria-live="polite">
        <div class="calc__row">
          <span class="k">Deals lost per month</span>
          <span class="v is-loss" id="out-deals">31</span>
        </div>
        <div class="calc__row">
          <span class="k">Annual revenue leak</span>
          <span class="v is-loss" id="out-leak">$19.5M</span>
        </div>
        <div class="calc__row">
          <span class="k">Recoverable under five minutes</span>
          <span class="v is-gain" id="out-gain">$13.7M</span>
        </div>

        <form class="calc__email" id="calc-form" novalidate>
          <label for="calc-email">Email these numbers to yourself</label>
          <div class="calc__email-row">
            <input type="email" id="calc-email" name="email" placeholder="you@company.com" autocomplete="email" required />
            <button type="submit" id="calc-submit">Send</button>
          </div>
          <p class="calc__success" id="calc-success" role="status" hidden>
            On its way. <a href="/contact">Book a call</a> if you want to walk through them.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ endpoint: site.form }}>
  (function () {
    const $ = (id) => document.getElementById(id);
    const leadsEl = $('calc-leads'), timeEl = $('calc-time'), valueEl = $('calc-value');
    const outDeals = $('out-deals'), outLeak = $('out-leak'), outGain = $('out-gain');
    const form = $('calc-form'), emailEl = $('calc-email');
    const submitBtn = $('calc-submit'), success = $('calc-success');
    if (!leadsEl) return;

    // Share of inbound that never converts because the response was too slow,
    // by response-time band. Recovery assumes getting under five minutes claws
    // back 70% of that, which is the conservative end of what we have measured.
    const RECOVERY_RATE = 0.7;

    const money = (n) => {
      if (n >= 1e9) return '$' + (n / 1e9).toFixed(1).replace(/\.0$/, '') + 'B';
      if (n >= 1e6) return '$' + (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
      if (n >= 1e3) return '$' + Math.round(n / 1e3) + 'K';
      return '$' + Math.round(n).toLocaleString();
    };

    const read = () => ({
      leads: parseFloat(leadsEl.value) || 0,
      lossRate: parseFloat(timeEl.value) || 0,
      value: parseFloat(valueEl.value) || 0,
    });

    function recalc() {
      const { leads, lossRate, value } = read();
      const dealsLost = leads * lossRate;
      outDeals.textContent = Math.round(dealsLost).toLocaleString();
      outLeak.textContent = money(dealsLost * value * 12);
      outGain.textContent = money(dealsLost * RECOVERY_RATE * value * 12);
    }

    ['change', 'input'].forEach((ev) => {
      leadsEl.addEventListener(ev, recalc);
      timeEl.addEventListener(ev, recalc);
      valueEl.addEventListener(ev, recalc);
    });
    recalc();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (emailEl.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailEl.focus();
        emailEl.setAttribute('aria-invalid', 'true');
        return;
      }
      emailEl.removeAttribute('aria-invalid');

      const { leads, lossRate, value } = read();
      const dealsLost = leads * lossRate;
      const payload = new FormData();
      payload.append('source', 'speed-to-lead calculator');
      payload.append('email', email);
      payload.append('leads_band', leadsEl.options[leadsEl.selectedIndex].text);
      payload.append('response_band', timeEl.options[timeEl.selectedIndex].text);
      payload.append('avg_deal_value_usd', String(value));
      payload.append('deals_lost_per_month', String(Math.round(dealsLost)));
      payload.append('annual_revenue_leak_usd', String(Math.round(dealsLost * value * 12)));
      payload.append('annual_recoverable_usd', String(Math.round(dealsLost * RECOVERY_RATE * value * 12)));
      payload.append('page', location.href);

      submitBtn.textContent = 'Sending';
      submitBtn.disabled = true;
      fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: payload })
        .then((r) => {
          submitBtn.disabled = false;
          if (r.ok) { submitBtn.textContent = 'Sent'; success.hidden = false; emailEl.value = ''; }
          else { submitBtn.textContent = 'Try again'; }
        })
        .catch(() => { submitBtn.disabled = false; submitBtn.textContent = 'Try again'; });
    });
  })();
</script>

<style>
  .calc { display: grid; gap: 0; background: var(--surface);
          border: 1px solid var(--rule-strong); border-radius: var(--radius-lg); overflow: hidden; }
  @media (min-width: 900px) { .calc { grid-template-columns: 1fr 1fr; } }
  .calc__inputs { padding: clamp(1.6rem, 2.6vw, 2.4rem); display: grid; gap: 1.5rem; align-content: start; }
  .calc__field label { display: block; font-family: var(--font-mono); font-size: .68rem;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: .55rem; }
  .calc__field select, .calc__field input {
    width: 100%; padding: .8rem .9rem; font-family: var(--font-sans); font-size: .98rem;
    color: var(--ink); background: var(--ground); border: 1px solid var(--rule-strong);
    border-radius: var(--radius); appearance: none;
  }
  .calc__field select { background-image: linear-gradient(45deg, transparent 50%, var(--ink-muted) 50%),
                                          linear-gradient(135deg, var(--ink-muted) 50%, transparent 50%);
    background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%;
    background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; padding-right: 2.4rem; }
  .calc__field input[aria-invalid] { border-color: var(--negative); }

  .calc__out { padding: clamp(1.6rem, 2.6vw, 2.4rem); background: var(--surface-ink); color: var(--ink-onDark); }
  .calc__row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
               padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
  .calc__row .k { font-size: .88rem; color: var(--steel); }
  .calc__row .v { font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1; }
  .calc__row .v.is-loss { color: #E8919D; }
  .calc__row .v.is-gain { color: #7FD3AE; }

  .calc__email { margin-top: 1.6rem; }
  .calc__email label { display: block; font-family: var(--font-mono); font-size: .68rem;
    letter-spacing: .14em; text-transform: uppercase; color: var(--steel); margin-bottom: .6rem; }
  .calc__email-row { display: flex; gap: .5rem; }
  .calc__email input { flex: 1; min-width: 0; padding: .75rem .85rem; font-size: .95rem;
    color: #fff; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.18);
    border-radius: var(--radius); }
  .calc__email input::placeholder { color: #7F93A8; }
  .calc__email input[aria-invalid] { border-color: #E8919D; }
  .calc__email button { padding: .75rem 1.2rem; background: var(--navy); color: #fff;
    border: 1px solid var(--navy); border-radius: var(--radius); font-size: .92rem;
    font-weight: 500; cursor: pointer; }
  .calc__email button:hover:not(:disabled) { background: var(--navy-deep); }
  .calc__email button:disabled { opacity: .6; cursor: default; }
  .calc__success { margin: .9rem 0 0; font-size: .9rem; color: #7FD3AE; }
  .calc__success a { color: #fff; }
</style>
