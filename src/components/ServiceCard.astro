---
import type { Service } from '../data/site';
interface Props { service: Service; }
const { service } = Astro.props;
---
<a class="svc" href={`/services/${service.slug}`}>
  <h3>{service.title}</h3>
  <p class="svc__sum">{service.summary}</p>
  <p class="svc__more">Read more <span aria-hidden="true">&rarr;</span></p>
</a>

<style>
  /* Asymmetric radius (6px 0 0 0) is the Ventriloc signature card shape:
     soft top-left, sharp everywhere else. Surface colour does the lifting,
     no border, no shadow. */
  .svc {
    display: flex; flex-direction: column; height: 100%;
    background: var(--card); border: 0; border-radius: var(--radius-asym);
    padding: clamp(1.8rem, 2.6vw, 2.4rem);
    text-decoration: none; color: inherit;
    transition: background .16s ease;
  }
  .svc:hover { background: var(--card-hover); }
  .svc h3 { margin: 0 0 .8rem; color: var(--ink); }
  .svc__sum { color: var(--ink-body); font-size: .96rem; margin: 0 0 1.4rem; flex: 1; }
  .svc__more { margin: 0; color: var(--ink); font-size: .9rem; font-weight: 500;
               text-decoration: underline; text-decoration-color: var(--mint);
               text-underline-offset: 3px; }
  .svc:hover .svc__more span { padding-left: 4px; transition: padding .16s ease; }
</style>
