---
import type { Service } from '../data/site';
interface Props { service: Service; }
const { service } = Astro.props;
---
<a class="svc" href={`/services/${service.slug}`}>
  <p class="svc__shape">{service.shape}</p>
  <h3>{service.title}</h3>
  <p class="svc__sum">{service.summary}</p>
  <p class="svc__more">Read more <span aria-hidden="true">&rarr;</span></p>
</a>

<style>
  .svc {
    display: flex; flex-direction: column; height: 100%;
    background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 2.4vw, 2rem); text-decoration: none; color: inherit;
    transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease;
  }
  .svc:hover { border-color: var(--rule-strong); box-shadow: var(--shadow); transform: translateY(-2px); }
  .svc__shape { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em;
                text-transform: uppercase; color: var(--ink-muted); margin: 0 0 .9rem; }
  .svc h3 { margin: 0 0 .7rem; }
  .svc__sum { color: var(--ink-body); font-size: .96rem; margin: 0 0 1.4rem; flex: 1; }
  .svc__more { margin: 0; color: var(--navy); font-size: .9rem; font-weight: 500; }
  .svc:hover .svc__more span { padding-left: 4px; transition: padding .16s ease; }
</style>
