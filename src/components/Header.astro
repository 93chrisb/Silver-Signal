---
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__brand" aria-label={`${site.name} home`}>
      <img src="/logo.svg" alt="" width="34" height="25" />
      <span class="hdr__name">Silver Signal <em>Partners</em></span>
    </a>

    <input type="checkbox" id="navtoggle" class="visually-hidden" />
    <label for="navtoggle" class="hdr__burger" aria-hidden="true"><span></span><span></span></label>

    <nav class="hdr__nav" aria-label="Primary">
      {nav.filter((i) => i.href !== '/').map((i) => (
        <a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a>
      ))}
      <a href={site.booking} class="btn hdr__cta">Book a call</a>
    </nav>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 40; background: rgba(245,247,250,.9);
         backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between;
             gap: 1.5rem; padding-block: .85rem; flex-wrap: wrap; }
  .hdr__brand { display: flex; align-items: center; gap: .7rem; text-decoration: none; color: var(--ink); }
  .hdr__name { font-family: var(--font-display); font-size: 1.12rem; letter-spacing: -.01em; white-space: nowrap; }
  .hdr__name em { font-style: normal; color: var(--ink-muted); }
  .hdr__nav { display: flex; align-items: center; gap: 1.6rem; }
  .hdr__nav a { color: var(--ink-body); text-decoration: none; font-size: .93rem; }
  .hdr__nav a:hover { color: var(--navy); }
  .hdr__nav a[aria-current="page"] { color: var(--navy); font-weight: 500; }
  .hdr__cta { color: #fff !important; padding: .6rem 1.15rem; font-size: .88rem; }
  .hdr__burger { display: none; }

  @media (max-width: 900px) {
    .hdr__burger { display: grid; gap: 5px; cursor: pointer; padding: .5rem; }
    .hdr__burger span { display: block; width: 22px; height: 2px; background: var(--ink); }
    .hdr__nav { display: none; width: 100%; flex-direction: column; align-items: flex-start;
                gap: 1rem; padding-block: 1rem .4rem; }
    #navtoggle:checked ~ .hdr__nav { display: flex; }
  }
</style>
