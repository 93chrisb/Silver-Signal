---
import { services, engagements, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isServices = path.startsWith('/services');
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__brand" aria-label={`${site.name} home`}>
      <img src="/logo.svg" alt="" width="26" height="20" />
      <span class="hdr__name">Silver<span class="grad">Signal</span></span>
    </a>

    <input type="checkbox" id="navtoggle" class="visually-hidden" />
    <label for="navtoggle" class="hdr__burger" aria-hidden="true"><span></span><span></span></label>

    <nav class="hdr__nav" aria-label="Primary">
      <div class="hdr__pill">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>

        <div class="drop">
          <a href="/services" class="drop__top" aria-current={isServices ? 'page' : undefined}>
            Services <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>
          <div class="drop__menu">
            {services.map((s) => <a href={`/services/${s.slug}`}>{s.nav}</a>)}
            <p class="drop__label">Specific engagements</p>
            {engagements.map((s) => <a href={`/services/${s.slug}`}>{s.nav}</a>)}
          </div>
        </div>

        <a href="/blog" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Insights</a>
        <a href={site.linkedin}>About</a>
      </div>
      <a href="/contact" class="btn hdr__cta">Contact us</a>
    </nav>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 60; background: rgba(255,255,255,.92);
         backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between;
             gap: 1.5rem; padding-block: .95rem; flex-wrap: wrap; }
  .hdr__brand { display: flex; align-items: center; gap: .55rem; text-decoration: none;
                color: var(--ink); font-family: var(--font-sans);
                font-weight: 400; font-size: 1.05rem; letter-spacing: -0.01em; }
  .hdr__brand:hover { color: var(--ink); }
  .hdr__name { white-space: nowrap; }
  .hdr__name .grad { color: var(--mint); }

  .hdr__nav { display: flex; align-items: center; gap: 1rem; }
  .hdr__pill {
    display: inline-flex; align-items: center; gap: 1.4rem;
    background: var(--bg-raised); border-radius: var(--radius-pill);
    padding: 8px 18px;
  }
  .hdr__pill > a, .drop__top {
    font-family: var(--font-sans); font-weight: 400; font-size: .95rem;
    color: var(--ink); text-decoration: none; letter-spacing: -0.01em;
  }
  .hdr__pill > a:hover, .drop__top:hover, .drop:hover .drop__top { color: var(--mint); }
  .hdr__pill a[aria-current="page"] { color: var(--mint); }

  .drop { position: relative; }
  .drop__top { display: inline-flex; align-items: center; gap: .35rem; }
  .drop__menu {
    position: absolute; top: calc(100% + 1rem); left: -.6rem; min-width: 280px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    padding: .5rem; display: grid; gap: .1rem;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .16s ease, transform .16s ease, visibility .16s;
  }
  .drop:hover .drop__menu, .drop:focus-within .drop__menu { opacity: 1; visibility: visible; transform: none; }
  .drop__menu a { display: block; padding: .55rem .8rem; border-radius: var(--radius);
                  color: var(--ink); text-decoration: none; font-size: .9rem; }
  .drop__menu a:hover { background: var(--bg-raised); color: var(--mint); }
  .drop__label {
    margin: .5rem .8rem .1rem; padding-top: .6rem; border-top: 1px solid var(--line);
    font-family: var(--font-body); font-size: .64rem; font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase; color: var(--ink-muted);
  }

  .hdr__cta { padding: 10px 20px; font-size: .9rem; }
  .hdr__burger { display: none; }

  @media (max-width: 980px) {
    .hdr__burger { display: grid; gap: 5px; cursor: pointer; padding: .5rem; }
    .hdr__burger span { display: block; width: 22px; height: 2px; background: var(--ink); }
    .hdr__nav { display: none; width: 100%; flex-direction: column; align-items: stretch;
                gap: .8rem; padding-block: .8rem .4rem; }
    #navtoggle:checked ~ .hdr__nav { display: flex; }
    .hdr__pill { flex-direction: column; align-items: flex-start; gap: .6rem;
                 border-radius: var(--radius); padding: 1rem 1.2rem; width: 100%; }
    .drop__menu { position: static; opacity: 1; visibility: visible; transform: none;
                  border: 0; padding: .4rem 0 0 .8rem; background: transparent; min-width: 0; }
    .drop__label { margin-left: 0; margin-top: .4rem; }
    .hdr__cta { align-self: flex-start; }
  }
</style>
