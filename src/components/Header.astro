---
import { services, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isServices = path.startsWith('/services');
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__brand" aria-label={`${site.name} home`}>
      <img src="/logo.svg" alt="" width="30" height="22" />
      <span class="hdr__name">SILVER<span class="grad">SIGNAL</span></span>
    </a>

    <input type="checkbox" id="navtoggle" class="visually-hidden" />
    <label for="navtoggle" class="hdr__burger" aria-hidden="true"><span></span><span></span></label>

    <nav class="hdr__nav" aria-label="Primary">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>

      <div class="drop">
        <a href="/services" class="drop__top" aria-current={isServices ? 'page' : undefined}>
          Services <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </a>
        <div class="drop__menu">
          {services.map((s) => <a href={`/services/${s.slug}`}>{s.title}</a>)}
        </div>
      </div>

      <a href="/blog" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
      <a href="/contact" class="btn btn--ghost hdr__cta">CONTACT US</a>
    </nav>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 60; background: rgba(8,9,11,.86);
         backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between;
             gap: 1.5rem; padding-block: .9rem; flex-wrap: wrap; }
  .hdr__brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; color: var(--ink); }
  .hdr__name { font-weight: 700; font-size: 1.06rem; letter-spacing: .01em; white-space: nowrap; }
  .hdr__nav { display: flex; align-items: center; gap: 1.7rem; }
  .hdr__nav > a { color: var(--ink); text-decoration: none; font-size: .92rem; font-weight: 500; }
  .hdr__nav > a:hover { color: var(--mint); }
  .hdr__nav a[aria-current="page"] { color: var(--mint); }

  .drop { position: relative; }
  .drop__top { display: inline-flex; align-items: center; gap: .4rem; color: var(--ink);
               text-decoration: none; font-size: .92rem; font-weight: 500; }
  .drop__top:hover, .drop:hover .drop__top { color: var(--mint); }
  .drop__menu {
    position: absolute; top: calc(100% + .9rem); left: -1rem; min-width: 250px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: .5rem; display: grid; gap: .1rem;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .16s ease, transform .16s ease, visibility .16s;
    box-shadow: 0 24px 60px rgba(0,0,0,.5);
  }
  .drop:hover .drop__menu, .drop:focus-within .drop__menu { opacity: 1; visibility: visible; transform: none; }
  .drop__menu a { display: block; padding: .65rem .85rem; border-radius: var(--radius);
                  color: var(--ink-body); text-decoration: none; font-size: .92rem; }
  .drop__menu a:hover { background: var(--card-inset); color: var(--mint); }

  .hdr__cta { padding: .6rem 1.25rem; font-size: .8rem; letter-spacing: .06em; }
  .hdr__burger { display: none; }

  @media (max-width: 980px) {
    .hdr__burger { display: grid; gap: 5px; cursor: pointer; padding: .5rem; }
    .hdr__burger span { display: block; width: 22px; height: 2px; background: var(--ink); }
    .hdr__nav { display: none; width: 100%; flex-direction: column; align-items: flex-start;
                gap: 1rem; padding-block: 1rem .4rem; }
    #navtoggle:checked ~ .hdr__nav { display: flex; }
    .drop__menu { position: static; opacity: 1; visibility: visible; transform: none;
                  box-shadow: none; background: transparent; border: 0; padding: .4rem 0 0 .8rem; }
  }
</style>
