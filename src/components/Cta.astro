---
import { site } from '../data/site';
interface Props { heading?: string; body?: string; }
const {
  heading = 'Tell us what is broken.',
  body = 'Thirty minutes. Bring the org or the problem. You leave with a straight answer on whether it is worth fixing.',
} = Astro.props;
---
<section class="section section--raised">
  <div class="wrap wrap--narrow cta">
    <p class="eyebrow">Next step</p>
    <h2>{heading}</h2>
    <p class="lede">{body}</p>
    <p class="cta__actions">
      <a href={site.booking} class="btn">Book an audit</a>
      <a href={site.linkedin} class="btn btn--ghost">Connect on LinkedIn</a>
    </p>
  </div>
</section>

<style>
  .cta__actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2rem; }
</style>
