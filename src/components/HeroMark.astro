---
/* Enlarged, layered version of the Silver Signal mark: four nodes, crossed
   links, a lit hub. Fills the hero the way the reference site's 3D render does,
   without inventing brand imagery that doesn't exist yet. */
---
<div class="mark" aria-hidden="true">
  <svg viewBox="0 0 520 460" role="presentation">
    <defs>
      <radialGradient id="glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#7FB0DC" stop-opacity=".38" />
        <stop offset="55%" stop-color="#8FA6DE" stop-opacity=".10" />
        <stop offset="100%" stop-color="#08090B" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="link" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8FC5E8" />
        <stop offset="100%" stop-color="#8FA6DE" />
      </linearGradient>
      <filter id="soft" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="14" />
      </filter>
    </defs>

    <ellipse cx="260" cy="230" rx="240" ry="210" fill="url(#glow)" />

    <!-- outer scaffold -->
    <g stroke="url(#link)" stroke-width="1.6" opacity=".38" fill="none">
      <path d="M92 78 L428 78 M92 382 L428 382 M92 78 L428 382 M428 78 L92 382" />
      <path d="M92 78 L92 382 M428 78 L428 382" opacity=".45" />
    </g>

    <!-- satellite links into the hub -->
    <g stroke="url(#link)" stroke-width="1" opacity=".22" fill="none">
      <path d="M260 230 L160 150 M260 230 L360 150 M260 230 L160 310 M260 230 L360 310" />
    </g>

    <!-- nodes -->
    <g fill="#8CA3BE">
      <circle cx="92" cy="78" r="9" /><circle cx="428" cy="78" r="9" />
      <circle cx="92" cy="382" r="9" /><circle cx="428" cy="382" r="9" />
    </g>
    <g fill="#5E7FA8" opacity=".85">
      <circle cx="160" cy="150" r="5" /><circle cx="360" cy="150" r="5" />
      <circle cx="160" cy="310" r="5" /><circle cx="360" cy="310" r="5" />
    </g>

    <!-- hub -->
    <circle cx="260" cy="230" r="46" fill="#7FB0DC" opacity=".22" filter="url(#soft)" />
    <circle cx="260" cy="230" r="30" fill="#1B3A57" stroke="#7FB0DC" stroke-width="2.5" />
    <circle cx="260" cy="230" r="10" fill="#DCEBFA" />
  </svg>
</div>

<style>
  .mark { width: 100%; max-width: 560px; margin-inline: auto; }
  .mark svg { width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .mark svg { animation: drift 14s ease-in-out infinite; }
    @keyframes drift { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  }
</style>
