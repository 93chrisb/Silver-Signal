---
/* Ventriloc-style data card cluster. The charts ARE the imagery.
   A line chart card, a stat card, and a ring card overlap on the warm
   canvas, showing the numbers Silver Signal fixes. Ember Orange and Brass
   are the only chromatic accents. */
---
<div class="mark" aria-hidden="true">
  <!-- Line chart card -->
  <div class="mark__card mark__card--chart">
    <div class="mark__row">
      <span class="mark__k">Response time</span>
      <span class="mark__delta">-96%</span>
    </div>
    <svg viewBox="0 0 320 140" role="presentation" class="mark__chart">
      <defs>
        <linearGradient id="fillEmber" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ff682c" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#ff682c" stop-opacity="0" />
        </linearGradient>
      </defs>
      <!-- Grid -->
      <g stroke="#e8e8e8" stroke-width="1">
        <line x1="0" y1="35" x2="320" y2="35" />
        <line x1="0" y1="70" x2="320" y2="70" />
        <line x1="0" y1="105" x2="320" y2="105" />
      </g>
      <!-- Brass (baseline: what we replace) -->
      <path d="M0 30 C 60 32, 120 40, 180 55 S 280 90, 320 108"
            fill="none" stroke="#816729" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.7" />
      <!-- Ember (after the fix) -->
      <path d="M0 30 C 60 42, 120 58, 180 78 S 280 118, 320 128"
            fill="url(#fillEmber)" stroke="none" />
      <path d="M0 30 C 60 42, 120 58, 180 78 S 280 118, 320 128"
            fill="none" stroke="#ff682c" stroke-width="2" stroke-linecap="round" />
      <!-- Endpoint dot -->
      <circle cx="320" cy="128" r="4" fill="#ff682c" />
    </svg>
    <div class="mark__legend">
      <span><i class="dot dot--ember"></i>After</span>
      <span><i class="dot dot--brass"></i>Before</span>
    </div>
  </div>

  <!-- Stat card -->
  <div class="mark__card mark__card--stat">
    <span class="mark__k">Pipeline attributed</span>
    <span class="mark__stat">$1.2M</span>
    <span class="mark__sub">First 12 months</span>
  </div>

  <!-- Ring card -->
  <div class="mark__card mark__card--ring">
    <svg viewBox="0 0 120 120" role="presentation">
      <circle cx="60" cy="60" r="46" fill="none" stroke="#e8e8e8" stroke-width="10" />
      <circle cx="60" cy="60" r="46" fill="none" stroke="#ff682c" stroke-width="10"
              stroke-linecap="round"
              stroke-dasharray="289"
              stroke-dashoffset="80"
              transform="rotate(-90 60 60)" />
      <text x="60" y="66" text-anchor="middle"
            font-family="Inter Tight, system-ui" font-size="24" font-weight="400"
            fill="#202020" letter-spacing="-0.5">72%</text>
    </svg>
    <span class="mark__sub">Conversion lift</span>
  </div>
</div>

<style>
  .mark {
    position: relative; width: 100%; max-width: 520px; margin-inline: auto;
    min-height: 380px;
  }
  .mark__card {
    background: #fff; border-radius: 20px; padding: 1.2rem 1.4rem;
    position: absolute;
  }
  .mark__card--chart { top: 0; left: 0; right: 40px; }
  .mark__card--stat { bottom: 24px; left: 24px; width: 200px; }
  .mark__card--ring { bottom: 0; right: 0; width: 168px; text-align: center;
                      display: flex; flex-direction: column; align-items: center; gap: .6rem;
                      padding: 1.2rem; }
  .mark__card--ring svg { width: 110px; height: 110px; }

  .mark__row { display: flex; align-items: baseline; justify-content: space-between;
               margin-bottom: .6rem; }
  .mark__k { font-family: var(--font-body); font-size: .68rem; letter-spacing: .18em;
             text-transform: uppercase; color: var(--ink-muted); font-weight: 500; }
  .mark__delta { font-family: var(--font-sans); font-size: 1rem; color: var(--mint);
                 letter-spacing: -0.01em; }
  .mark__chart { width: 100%; height: auto; }
  .mark__legend { display: flex; gap: 1.2rem; margin-top: .6rem;
                  font-family: var(--font-body); font-size: .72rem;
                  color: var(--ink-body); letter-spacing: .02em; }
  .mark__legend span { display: inline-flex; align-items: center; gap: .4rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .dot--ember { background: var(--mint); }
  .dot--brass { background: var(--violet); }

  .mark__stat { display: block; font-family: var(--font-sans); font-weight: 400;
                font-size: 2.4rem; color: var(--ink); line-height: 1;
                letter-spacing: -0.03em; margin: .8rem 0 .4rem; }
  .mark__sub { display: block; font-family: var(--font-body); font-size: .78rem;
               color: var(--ink-muted); }

  @media (max-width: 640px) {
    .mark { min-height: 320px; max-width: 100%; }
    .mark__card--chart { right: 0; }
    .mark__card--stat { width: 160px; }
    .mark__card--ring { width: 140px; }
    .mark__card--ring svg { width: 90px; height: 90px; }
  }
</style>
