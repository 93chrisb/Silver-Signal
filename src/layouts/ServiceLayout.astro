---
import Base from './Base.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { site, type Service } from '../data/site';

interface Props { service: Service; faqs: { q: string; a: string }[]; ctaHeading?: string; }
const { service, faqs, ctaHeading } = Astro.props;
const url = `${site.url}/services/${service.slug}`;

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}/#service`,
    name: service.title,
    description: service.metaDescription,
    serviceType: service.title,
    url,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United States' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: service.title, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}/#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base title={service.metaTitle} description={service.metaDescription} schema={schema}>
  <section class="shero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>{service.title}</span>
      </nav>
        <h1>{service.h1}</h1>
      <p class="lede shero__lede">{service.summary}</p>
      <p class="shero__actions"><a href={site.booking} class="btn">Book a 30 minute call</a></p>
    </div>
  </section>

  <slot />

  <Faq items={faqs} />
  <Cta heading={ctaHeading} />
</Base>

<style>
  .shero { padding-block: clamp(36px, 5vw, 64px) clamp(48px, 7vw, 88px);
           background: linear-gradient(170deg, var(--bg-raised) 0%, var(--bg) 70%); }
  .crumbs { display: flex; gap: .6rem; align-items: center; font-size: .82rem;
            color: var(--ink-muted); margin-bottom: 2.4rem; font-family: var(--font-mono); }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--mint); }
  .shero h1 { margin-bottom: 1.3rem; max-width: 18ch; }
  .shero__lede { max-width: 58ch; }
  .shero__actions { margin: 2.2rem 0 0; }
</style>
