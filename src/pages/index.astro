---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { services, engagements, site } from '../data/site';

const faqs = [
  {
    q: 'Are you a Salesforce partner?',
    a: 'No. Independent. No reseller margin on your licences, no pressure to expand your contract.',
  },
  {
    q: 'How small is too small?',
    a: 'Under about ten people in Salesforce, most of what we do is more machinery than you need. Say so on the call and we will point you somewhere cheaper.',
  },
  {
    q: 'Do you work with our existing admin or agency?',
    a: 'Usually, yes. An in-house admin who knows the business is the most valuable person in the room. We unblock that person rather than replace them.',
  },
  {
    q: 'What happens when the engagement ends?',
    a: 'You keep the org, the documentation and the deployment history. No managed-service contract to sign to keep it running.',
  },
  {
    q: 'Which clouds do you work in?',
    a: 'Sales, Service, Marketing and Experience Cloud, plus the integration work around them. We organise by the problem, not by the licence you bought.',
  },
];

const schema = [
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  title="Silver Signal Partners | Salesforce Consulting for Revenue Teams"
  description="Independent Salesforce consultancy. We fix the CRM your pipeline runs on, then hand it back working."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero__inner">
      <h1>Do you want to make better decisions for your business?</h1>
      <p class="lede hero__lede">
        We took Datto's Salesforce to IPO scale. Now we do it for smaller teams.
      </p>
      <p class="hero__actions">
        <a href={site.booking} class="btn hero__cta">Book an audit</a>
        <a href="#services" class="btn btn--ghost">How we work</a>
      </p>
    </div>
  </section>

  <section class="section" id="problem">
    <div class="wrap">
      <p class="eyebrow">01 — Where it breaks</p>
      <h2>The software is fine. The build is the problem.</h2>
      <div class="grid grid--3" style="margin-top:2.6rem;">
        <div class="card">
          <h3>Data your team works around</h3>
          <p>Three fields that mean the same thing. Required fields filled with a full stop to beat validation. The real forecast lives in a spreadsheet.</p>
        </div>
        <div class="card">
          <h3>Process in people's heads</h3>
          <p>Routing that made sense with four reps. Handoffs happening in DMs. One person who knows why the automation fires on Tuesdays, and they're on leave.</p>
        </div>
        <div class="card">
          <h3>A backlog with no owner</h3>
          <p>Requests queued behind a part-time admin. Integrations failing quietly. Changes deployed straight to production.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--raised" id="services">
    <div class="wrap">
      <p class="eyebrow">02 — Services</p>
      <h2>The Salesforce practice.</h2>
      <p class="lede" style="margin-bottom:3rem;">Nine ways to bring us in, plus outcome-focused engagements when the problem already has a name.</p>
      <div class="grid grid--3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>

      <p class="eyebrow" style="margin-top:3.6rem;">Specific engagements</p>
      <div class="grid grid--2">
        {engagements.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section" id="proof">
    <div class="wrap">
      <p class="eyebrow">03 — Proof</p>
      <h2><span class="grad">Six hours</span> to four minutes.</h2>
      <div class="proof">
        <div>
          <p class="lede">
            A personal injury firm running seven figures a year through paid. Leads arrived, cooled in a shared inbox, retained a competitor.
          </p>
          <p>
            We rebuilt intake inside Salesforce. Qualification on arrival. Routing to a named calendar. One record from ad click to signed retainer. No new headcount.
          </p>
        </div>
        <div class="stats">
          <div class="stat"><p class="stat__k">Response</p><p class="stat__v">4 min</p><p class="stat__n">from six hours</p></div>
          <div class="stat"><p class="stat__k">Conversion</p><p class="stat__v">+38%</p><p class="stat__n">appointments vs baseline</p></div>
          <div class="stat"><p class="stat__k">Pipeline</p><p class="stat__v">$1.2M</p><p class="stat__n">attributed, first 12 months</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--raised" id="ai">
    <div class="wrap">
      <p class="eyebrow">04 — Applied AI</p>
      <h2>Where AI earns its place.</h2>
      <p class="lede" style="margin-bottom:2.4rem;">Boring parts, done well.</p>
      <div class="grid grid--2">
        <ul class="rows">
          <li><strong>Migration mapping.</strong> Reading a legacy schema, proposing the field-by-field mapping. A human signs off every row.</li>
          <li><strong>Apex and Flow scaffolding.</strong> First-draft classes and test coverage against your existing patterns, reviewed like any other code.</li>
        </ul>
        <ul class="rows">
          <li><strong>Documentation nobody was going to write.</strong> What the automation does, why it exists, what breaks if you change it.</li>
          <li><strong>Intake qualification.</strong> Inside products we build for you, where a model reads an inbound enquiry and routes it.</li>
        </ul>
      </div>
      <p class="muted" style="margin-top:1.6rem;">
        No model has unattended write access to your production org. Rule, not preference.
      </p>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <p class="eyebrow">05 — How engagements run</p>
      <h2>Diagnose, fix, hand back.</h2>
      <ol class="steps">
        <li>
          <span class="steps__n">01</span>
          <div>
            <h3>Diagnose</h3>
            <p>We go through the org, the metadata, the way your team actually works, then tell you what is wrong in writing. Sometimes the report says it isn't worth the fix. You get told that too.</p>
          </div>
        </li>
        <li>
          <span class="steps__n">02</span>
          <div>
            <h3>Fix</h3>
            <p>Scoped work against an agreed definition of done. Built in a sandbox. Deployed on a schedule you approve.</p>
          </div>
        </li>
        <li>
          <span class="steps__n">03</span>
          <div>
            <h3>Hand back</h3>
            <p>Documentation, deployment history, and a walkthrough with whoever owns it next. The engagement ends.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <Faq items={faqs} />
  <Cta />
</Base>

<style>
  .hero { padding-block: clamp(80px, 12vw, 160px) clamp(56px, 8vw, 96px); background: var(--bg);
          text-align: center; }
  .hero__inner { max-width: 900px; margin-inline: auto; }
  .hero h1 { margin: 0 auto 1.6rem; max-width: 20ch; }
  .hero__lede { max-width: 48ch; margin: 0 auto 2rem; font-size: clamp(1.05rem, 1.5vw, 1.25rem); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .9rem; margin: 0; justify-content: center; }
  .hero__cta { padding: 14px 32px; font-size: 1rem; letter-spacing: .06em; text-transform: uppercase; }

  .proof { display: grid; gap: 3rem; margin-top: 2.6rem; }
  @media (min-width: 940px) { .proof { grid-template-columns: 1.15fr 1fr; gap: 4rem; } }

  .steps { list-style: none; counter-reset: s; margin: 2.4rem 0 0; padding: 0;
           display: grid; gap: 0; }
  .steps li { padding: 2rem 0; border-top: 1px solid var(--line-strong);
              display: grid; gap: .3rem 2.5rem; }
  .steps li:last-child { border-bottom: 1px solid var(--line-strong); }
  @media (min-width: 820px) { .steps li { grid-template-columns: 90px 1fr; } }
  .steps__n { font-family: var(--font-body); font-size: .78rem; color: var(--ink-muted);
              padding-top: .35rem; letter-spacing: .06em; }
  .steps h3 { margin: 0 0 .5rem; color: var(--ink); }
  .steps p { margin: 0; }
</style>
