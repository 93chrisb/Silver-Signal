---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact/#page`,
    url: `${site.url}/contact/`,
    name: 'Contact Silver Signal Partners',
    about: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact/` },
    ],
  },
];
---
<Base
  title="Contact | Silver Signal Partners"
  description="Book a 30 minute call about your Salesforce org, a stalled implementation, or the revenue system underneath it."
  schema={schema}
>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Contact</span>
      </nav>
      <p class="eyebrow">Get in touch</p>
      <h1>Thirty minutes, no pitch.</h1>
      <p class="lede" style="max-width:58ch;">
        Pick any open slot below. Bring the org, the backlog, or the problem you have
        stopped being able to describe politely. A calendar invite arrives immediately.
      </p>

      <div class="cal-embed" id="cal-inline">
        <noscript>
          JavaScript is required to show the live calendar.
          <a href={site.booking} target="_blank" rel="noopener">Open the booking page directly &rarr;</a>
        </noscript>
      </div>

      <div class="cal-fallback">
        <p class="muted">Calendar not loading, or prefer a new tab?</p>
        <a class="btn btn--ghost" href={site.booking} target="_blank" rel="noopener">Open booking page</a>
      </div>

      <dl class="direct">
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>LinkedIn</dt><dd><a href={site.linkedin}>linkedin.com/company/silversignal</a></dd></div>
        <div><dt>Address</dt><dd>{site.address.line1}<br />{site.address.line2}<br />{site.address.line3}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1]; api.q = api.q || [];
        if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); }
        else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "30min", { origin: "https://cal.com" });
  // Dark theme so the widget matches the site rather than loading as a white block.
  Cal.ns["30min"]("inline", {
    elementOrSelector: "#cal-inline",
    config: { layout: "month_view", theme: "dark" },
    calLink: "silver-signal-m0hq3w/30min",
  });
  Cal.ns["30min"]("ui", {
    theme: "dark",
    hideEventTypeDetails: false,
    layout: "month_view",
    cssVarsPerTheme: { dark: { "cal-brand": "#7FB0DC" } },
  });
</script>

<style>
  .crumbs { display: flex; gap: .6rem; align-items: center; font-size: .82rem;
            color: var(--ink-muted); margin-bottom: 2.4rem; font-family: var(--font-mono); }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--mint); }

  .cal-embed { width: 100%; min-height: 760px; margin-top: 2.6rem;
               border: 1px solid var(--line); border-radius: var(--radius-lg);
               overflow: hidden; background: var(--card); }
  .cal-embed noscript { display: block; padding: 24px; text-align: center;
                        color: var(--ink-body); font-size: .93rem; }

  .cal-fallback { display: flex; align-items: center; justify-content: space-between;
                  gap: 1rem; flex-wrap: wrap; margin-top: 1.2rem; padding-top: 1.2rem;
                  border-top: 1px solid var(--line); }
  .cal-fallback p { margin: 0; }

  .direct { display: grid; gap: 0; margin: 3rem 0 0; border-top: 1px solid var(--line-strong); }
  @media (min-width: 800px) { .direct { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .direct > div { padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 800px) { .direct > div { border-bottom: 0; } }
  .direct dt { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .16em;
               text-transform: uppercase; color: var(--ink-muted); margin-bottom: .45rem; }
  .direct dd { margin: 0; font-size: .95rem; color: var(--ink); }
</style>
