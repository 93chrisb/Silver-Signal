---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact/#page`,
    url: `${site.url}/contact/`,
    name: 'Contact Silver Signal Partners',
    about: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact/` },
    ],
  },
];
---
<Base
  title="Contact | Silver Signal Partners"
  description="Book a 30 minute call about your Salesforce org, a stalled implementation, or the revenue system underneath it."
  schema={schema}
>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Contact</span>
      </nav>
      <p class="eyebrow">Get in touch</p>
      <h1>Thirty minutes, no pitch.</h1>
      <p class="lede" style="max-width:56ch;">
        Bring the org, the backlog, or the problem you have stopped being able to describe
        politely. You will leave with a straight answer on whether it is worth fixing and
        roughly what that takes.
      </p>

      <div class="contact">
        <div class="card contact__book">
          <h2>Pick a slot</h2>
          <p class="muted">A calendar invite arrives immediately.</p>
          <p style="margin-top:1.4rem;"><a class="btn" href={site.booking}>Open the booking page</a></p>
        </div>

        <dl class="contact__direct">
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href={site.linkedin}>linkedin.com/company/silversignal</a></dd></div>
          <div>
            <dt>Address</dt>
            <dd>{site.address.line1}<br />{site.address.line2}<br />{site.address.line3}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { display: flex; gap: .6rem; align-items: center; font-size: .82rem;
            color: var(--ink-muted); margin-bottom: 2.4rem; font-family: var(--font-mono); }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .contact { display: grid; gap: 2.5rem; margin-top: 3.2rem; align-items: start; }
  @media (min-width: 900px) { .contact { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }
  .contact__book h2 { margin: 0 0 .4rem; font-size: 1.35rem; }
  .contact__direct { margin: 0; border-top: 1px solid var(--rule-strong); }
  .contact__direct > div { padding: 1.3rem 0; border-bottom: 1px solid var(--rule); }
  .contact__direct dt { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .16em;
                        text-transform: uppercase; color: var(--ink-muted); margin-bottom: .4rem; }
  .contact__direct dd { margin: 0; font-size: .96rem; color: var(--ink); }
</style>
