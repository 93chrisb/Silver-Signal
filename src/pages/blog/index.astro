---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  {
    '@type': 'Blog',
    '@id': `${site.url}/blog/#blog`,
    url: `${site.url}/blog/`,
    name: `${site.name} Blog`,
    publisher: { '@id': `${site.url}/#organization` },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPost',
      headline: p.data.title,
      description: p.data.description,
      datePublished: p.data.date,
      url: `${site.url}/blog/${p.id}/`,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog/` },
    ],
  },
];
---
<Base
  title="Blog | Silver Signal Partners"
  description="Writing on Salesforce, revenue operations, lead response and the systems underneath how companies sell."
  schema={schema}
>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Blog</span>
      </nav>
      <p class="eyebrow">Writing</p>
      <h1>Notes from the work.</h1>
      <p class="lede" style="margin-bottom:3.5rem;">
        Lead response, CRM builds that went wrong, and what we keep finding inside
        other people's Salesforce orgs.
      </p>

      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <time datetime={p.data.date}>{fmt(p.data.date)}</time>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <span class="posts__more">Read <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Cta />
</Base>

<style>
  .crumbs { display: flex; gap: .6rem; align-items: center; font-size: .82rem;
            color: var(--ink-muted); margin-bottom: 2.4rem; font-family: var(--font-mono); }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--mint); }
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .posts li { border-bottom: 1px solid var(--line); }
  .posts a { display: block; padding: 2rem 0; text-decoration: none; color: inherit; }
  .posts a:hover h2 { color: var(--mint); }
  .posts time { font-family: var(--font-mono); font-size: .74rem; letter-spacing: .1em;
                text-transform: uppercase; color: var(--ink-muted); }
  .posts h2 { font-size: clamp(1.35rem, 2.2vw, 1.75rem); margin: .6rem 0 .5rem; max-width: 30ch;
              transition: color .16s ease; }
  .posts p { margin: 0 0 .9rem; max-width: 72ch; }
  .posts__more { color: var(--mint); font-size: .9rem; font-weight: 500; }
</style>
