---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { services } from '../../data/site';
const service = services.find((s) => s.slug === 'advisory')!;
---
<ServiceLayout service={service}>
  <section class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">When to bring us in</p>
      <ul class="rows">
        <li>Before signing a statement of work you cannot fully evaluate.</li>
        <li>Before picking between Salesforce and a competitor, or between clouds.</li>
        <li>Before spending on integrations, licences or a delivery partner.</li>
      </ul>

      <p class="eyebrow" style="margin-top:2.6rem;">What you get</p>
      <ul class="rows">
        <li>An independent read on the technical case, in writing.</li>
        <li>Roadmap and architecture recommendations with the reasoning behind them.</li>
        <li>Vendor and contract review, including the questions you should be asking.</li>
        <li>No commercial interest in the answer.</li>
      </ul>
    </div>
  </section>
</ServiceLayout>
