---
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Cta from '../../components/Cta.astro';
import { services, site } from '../../data/site';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/services/#page`,
    url: `${site.url}/services/`,
    name: 'Services',
    about: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title,
      url: `${site.url}/services/${s.slug}/`,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
    ],
  },
];
---
<Base
  title="Services | Silver Signal Partners"
  description="Salesforce consulting services: speed to lead, revenue engine build, fractional CTO and rescue engagements for stalled implementations."
  schema={schema}
>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Services</span>
      </nav>
      <p class="eyebrow">Services</p>
      <h1>Four ways to bring us in.</h1>
      <p class="lede" style="margin-bottom:3.2rem;">
        Pick by the problem in front of you rather than the licence you happen to hold.
      </p>
      <div class="grid grid--2">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>
  <Cta />
</Base>

<style>
  .crumbs { display: flex; gap: .6rem; align-items: center; font-size: .82rem;
            color: var(--ink-muted); margin-bottom: 2.4rem; font-family: var(--font-mono); }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--mint); }
</style>
