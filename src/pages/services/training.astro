---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { services } from '../../data/site';
const service = services.find((s) => s.slug === 'training')!;
---
<ServiceLayout service={service}>
  <section class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">When to bring us in</p>
      <ul class="rows">
        <li>You have just deployed a new build and need people up to speed.</li>
        <li>Adoption metrics say the team is working around the system.</li>
        <li>You have new admins or developers who need to be productive quickly.</li>
      </ul>

      <p class="eyebrow" style="margin-top:2.6rem;">What you get</p>
      <ul class="rows">
        <li>Role-based curriculum: end-user, admin, developer.</li>
        <li>On-site, remote or self-paced, or a mix.</li>
        <li>Materials built around your actual configuration, not a generic feature tour.</li>
        <li>Follow-up sessions to reinforce the habits.</li>
      </ul>
    </div>
  </section>
</ServiceLayout>
