---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { services } from '../../data/site';
const service = services.find((s) => s.slug === 'salesforce-qa')!;
---
<ServiceLayout service={service}>
  <section class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">When to bring us in</p>
      <ul class="rows">
        <li>Every release ends in an all-hands smoke test.</li>
        <li>Regressions keep making it to production.</li>
        <li>You are building enough to need proper test infrastructure but not enough to hire QA.</li>
      </ul>

      <p class="eyebrow" style="margin-top:2.6rem;">What you get</p>
      <ul class="rows">
        <li>Test strategy proportionate to your release rhythm.</li>
        <li>Manual test plans for the flows that matter.</li>
        <li>Automated regression coverage where it earns its keep.</li>
        <li>UAT support and release validation, so the deploy is boring.</li>
      </ul>
    </div>
  </section>
</ServiceLayout>
